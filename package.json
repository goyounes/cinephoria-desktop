{
  "name": "cinephoria-desktop",
  "productName": "Cinephoria Desktop",
  "version": "1.0.0",
  "description": "Desktop version of Cinephoria movie platform",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "npx electron .",
    "dev": "concurrently \"npm run start:react\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development npx electron .\"",
    "start:react": "cd ../client && npm start",
    "build:react": "cd ../client && npm run build",
    "build": "npm run build:react && npx electron-builder",
    "dist": "npm run build:react && npx electron-builder --publish=never",
    "pack": "npm run build:react && npx electron-builder --dir",
    "test:build": "npm run build:react && npx electron ."
  },
  "keywords": [],
  "author": "Younes",
  "license": "MIT",
  "build": {
    "appId": "com.cinephoria.desktop",
    "productName": "Cinephoria Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../client/build",
        "to": "client/build"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "forceCodeSigning": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.4"
  }
}
