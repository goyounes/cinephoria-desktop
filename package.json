{
  "name": "cinephoria-desktop",
  "productName": "Cinephoria Desktop",
  "version": "1.0.0",
  "description": "Desktop version of Cinephoria movie platform",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint src --color",
    "dev": "concurrently \"npm run start:react\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development npx electron .\"",
    "start:react": "cd ../client && npm start",
    "build:react": "cd ../client && npm run build",
    "build": "npm run build:react && npx electron-forge package",
    "dist": "npm run build:react && npx electron-forge make",
    "test:build": "npm run build:react && npx electron ."
  },
  "keywords": [],
  "author": "Younes",
  "license": "MIT",
  "config": {
    "forge": {
      "make_targets": {
        "win32": [
          "squirrel",
          "zip"
        ],
        "darwin": [
          "zip",
          "dmg"
        ],
        "linux": [
          "deb",
          "rpm",
          "zip"
        ]
      },
      "electronPackagerConfig": {
        "packageManager": "npm",
        "extraResource": [
          "../client/build"
        ],
        "ignore": [
          "node_modules/(?!(electron-squirrel-startup))"
        ]
      },
      "electronWinstallerConfig": {
        "name": "cinephoria_desktop",
        "setupExe": "Cinephoria-Desktop-Setup.exe"
      },
      "electronInstallerDebian": {
        "productName": "Cinephoria Desktop"
      },
      "electronInstallerRedhat": {
        "productName": "Cinephoria Desktop"
      },
      "github_repository": {
        "owner": "goyounes",
        "name": "cinephoria-desktop"
      },
      "windowsStoreConfig": {
        "packageName": "CinephoriaDesktop",
        "name": "Cinephoria Desktop"
      }
    }
  },
  "dependencies": {
    "electron-compile": "^6.4.4",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "babel-plugin-transform-async-to-generator": "^6.24.1",
    "babel-preset-env": "^1.7.0",
    "babel-preset-react": "^6.24.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-forge": "^5.2.4",
    "eslint": "^3.19.0",
    "eslint-config-airbnb": "^15.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^5.1.1",
    "eslint-plugin-react": "^7.37.5",
    "wait-on": "^8.0.4"
  }
}
